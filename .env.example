# ==============================================================================
# PLACENTRA Frontend Environment Configuration (Vercel / Vite)
# Note: Any variable prefixed with VITE_ is public and bundled into browser code.
# NEVER place private keys, database passwords, or secret tokens here.
# ==============================================================================

# Backend API Base URL (Render deployment URL)
# For local development: http://localhost:8000
# For production on Vercel: https://your-backend-app.onrender.com
VITE_API_BASE_URL=https://your-backend-app.onrender.com
