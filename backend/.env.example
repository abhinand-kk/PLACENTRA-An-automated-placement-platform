# ==============================================================================
# PLACENTRA Backend Environment Configuration Template
# DO NOT store real credentials in this file. Copy to .env for local use.
# ==============================================================================

# Core Django Settings
SECRET_KEY=generate-a-secure-random-secret-key-for-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,your-backend-app.onrender.com

# Database Connection (Supabase PostgreSQL in production)
# Render requires IPv4: use the Supabase Session Pooler URL (port 5432 or 6543)
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Local PostgreSQL Fallback (only used when DATABASE_URL is not set)
DB_NAME=placentra_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60

# CORS & CSRF Settings
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173
CSRF_TRUSTED_ORIGINS=https://your-frontend-app.vercel.app,https://your-backend-app.onrender.com

# Transactional Email Transport Options
# Option A: Gmail API via HTTPS & OAuth 2.0 (Recommended for @gmail.com)
# Set USE_GMAIL_API=True (or EMAIL_BACKEND_TYPE=gmail_api) with the OAuth credentials below
USE_GMAIL_API=False
EMAIL_BACKEND_TYPE=
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your-google-client-secret
GMAIL_REFRESH_TOKEN=1//0your-google-oauth-refresh-token
GMAIL_SENDER_EMAIL=placentraeducation@gmail.com
DEFAULT_FROM_EMAIL=PLACENTRA Education <placentraeducation@gmail.com>

# Option B: Resend API via django-anymail (Fallback when USE_GMAIL_API is False)
RESEND_API_KEY=re_your_resend_api_key_here
# DEFAULT_FROM_EMAIL=PLACENTRA <onboarding@resend.dev>

# Option C: Standard SMTP / Console (For local offline development)
# EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# Persistent Object Storage (Supabase S3-Compatible Storage)
# Set USE_S3_STORAGE=True once your Supabase Storage bucket and S3 credentials are ready
USE_S3_STORAGE=False
AWS_ACCESS_KEY_ID=your-supabase-project-ref-or-s3-access-key
AWS_SECRET_ACCESS_KEY=your-supabase-s3-secret-key
AWS_STORAGE_BUCKET_NAME=placentra-media
AWS_S3_ENDPOINT_URL=https://yourprojectref.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=us-east-1
